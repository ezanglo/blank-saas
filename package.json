{
  "name": "blank-saas",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "payload": "node --conditions=production node_modules/payload/bin.js",
    "migrate": "node --conditions=production node_modules/payload/bin.js migrate",
    "migrate:create": "node --conditions=production node_modules/payload/bin.js migrate:create",
    "docker:app": "sh scripts/docker-app-up.sh",
    "generate:types": "node --conditions=production node_modules/payload/bin.js generate:types",
    "generate:db-schema": "node --conditions=production node_modules/payload/bin.js generate:db-schema",
    "generate:importmap": "node --conditions=production node_modules/payload/bin.js generate:importmap",
    "email:dev": "email dev --dir src/lib/email/templates",
    "test:unit": "vitest run --exclude \"tests/integration/**\"",
    "test:unit:watch": "vitest --exclude \"tests/integration/**\"",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test": "pnpm test:e2e"
  },
  "dependencies": {
    "@better-auth/sso": "^1.7.26",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@payloadcms/db-postgres": "^3.94.0",
    "@payloadcms/next": "^3.94.0",
    "@payloadcms/richtext-lexical": "^3.94.0",
    "@payloadcms/storage-s3": "^3.94.0",
    "@payloadcms/ui": "^3.94.0",
    "@react-email/render": "^2.3.1",
    "@sentry/core": "10.52.0",
    "@sentry/nextjs": "^10.52.0",
    "@tabler/icons-react": "^3.52.0",
    "@tanstack/react-query": "^5.108.1",
    "@tanstack/react-table": "^8.21.3",
    "@upstash/ratelimit": "^2.2.1",
    "@upstash/redis": "^1.41.0",
    "better-auth": "^1.7.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "flags": "^4.4.1",
    "framer-motion": "^12.38.0",
    "graphql": "^16.14.0",
    "gray-matter": "^4.0.3",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.76.0",
    "next": "16.4.6",
    "next-mdx-remote": "^6.0.0",
    "next-sitemap": "^4.2.3",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.6.0",
    "payload": "^3.94.0",
    "pg": "^8.20.0",
    "posthog-js": "^1.453.0",
    "posthog-node": "^6.0.4",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-email": "^6.11.16",
    "react-hook-form": "^7.92.0",
    "recharts": "3.11.0",
    "shadcn": "^4.23.0",
    "sharp": "^0.35.5",
    "slugify": "^1.6.9",
    "sonner": "^2.0.8",
    "stripe": "^23.2.0",
    "svix": "^2.10.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
