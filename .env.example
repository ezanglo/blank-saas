# --- Database (PostgreSQL) ---
DATABASE_URL="postgres://user:password@127.0.0.1:5432/your_database"

# --- Payload ---
PAYLOAD_SECRET="generate-a-long-random-string"

# --- Better Auth ---
# Server-only secret for signing cookies / tokens
BETTER_AUTH_SECRET="generate-a-long-random-string"

# Canonical origin for Better Auth callbacks (omit trailing slash)
# Fallback order in code: BETTER_AUTH_URL → NEXT_PUBLIC_APP_URL → http://localhost:3000
BETTER_AUTH_URL="http://localhost:3000"

# Used by the app and Better Auth fallback base URL (safe to expose in browser)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: if auth API is on another origin than the Next app (rare locally)
# NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# --- Google OAuth (optional; enable when both are set) ---
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# --- Object storage for Payload Media (optional) ---
# If S3_BUCKET (or R2_BUCKET) is unset, S3 storage plugin stays disabled locally.

# AWS / S3-compatible (e.g. MinIO)
# S3_BUCKET=""
# S3_REGION="us-east-1"
# S3_ENDPOINT="http://127.0.0.1:9000"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# Cloudflare R2 (alternative)
# R2_BUCKET=""
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""

# Generic AWS region override if not using S3_REGION
# AWS_REGION="auto"

# --- Transactional email (optional; omit SMTP_HOST for console-only stubs) ---
# Gmail: enable 2FA → Google Account → Security → App passwords → create one
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="you@gmail.com"
# SMTP_PASSWORD="xxxx xxxx xxxx xxxx"   # 16-char App Password (spaces OK)
# SMTP_FROM="Your Name <you@gmail.com>"
