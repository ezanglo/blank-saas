# --- Database (PostgreSQL) ---
DATABASE_URL="postgres://user:password@127.0.0.1:5432/your_database"

# --- Payload ---
PAYLOAD_SECRET="generate-a-long-random-string"

# --- Better Auth ---
# Server-only secret for signing cookies / tokens
BETTER_AUTH_SECRET="generate-a-long-random-string"

# Canonical origin for Better Auth callbacks (omit trailing slash)
# Fallback order in code: BETTER_AUTH_URL → NEXT_PUBLIC_APP_URL → http://localhost:3000
BETTER_AUTH_URL="http://localhost:3000"

# Used by the app and Better Auth fallback base URL (safe to expose in browser)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: if auth API is on another origin than the Next app (rare locally)
# NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# --- Google OAuth (optional; enable when both are set) ---
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# --- Object storage for Payload Media (optional) ---
# If S3_BUCKET (or R2_BUCKET) is unset, S3 storage plugin stays disabled locally.

# AWS / S3-compatible (e.g. MinIO)
# S3_BUCKET=""
# S3_REGION="us-east-1"
# S3_ENDPOINT="http://127.0.0.1:9000"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# Cloudflare R2 (alternative)
# R2_BUCKET=""
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""

# Generic AWS region override if not using S3_REGION
# AWS_REGION="auto"

# --- Rate limiting (optional; API /api/* uses proxy — omit both to skip limits in dev) ---
# Upstash REST (Vercel / serverless; preferred for @upstash/ratelimit)
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
# Self-hosted Redis (IP fixed-window fallback in src/lib/quota/limiter.ts)
# REDIS_URL="redis://localhost:6379"
# Requests per IP per minute for /api/* (default: 100)
# API_RATE_LIMIT_PER_MINUTE="100"

# --- Transactional email (optional; omit SMTP_HOST for console-only stubs) ---
# Gmail: enable 2FA → Google Account → Security → App passwords → create one
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="you@gmail.com"
# SMTP_PASSWORD="xxxx xxxx xxxx xxxx"   # 16-char App Password (spaces OK)
# SMTP_FROM="Your Name <you@gmail.com>"

# --- Feature flags (flags SDK — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))") ---
# FLAGS_SECRET=""

# --- Stripe (Phase 7 — Billing) ---
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."  # optional until embedded Elements
# STRIPE_PRICE_PRO_MONTHLY="price_..."
# STRIPE_PRICE_PRO_YEARLY="price_..."
# STRIPE_PRICE_ENTERPRISE_MONTHLY="price_..."
# Local: stripe listen --forward-to localhost:3000/api/webhooks/stripe

# --- PostHog (Phase 8 — Analytics; optional in dev) ---
# NEXT_PUBLIC_POSTHOG_KEY=""
# NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"
# With Phase 11 docker-compose: http://localhost:8000
# Optional — not required for event capture (dashboard / API automation)
# POSTHOG_PERSONAL_API_KEY=""

# --- SAML SSO (Phase 9 — Better Auth `@better-auth/sso`; optional Jackson below) ---
# Uses `/api/auth/sso/*` routes (ACS, SP metadata, sign-in). Owners configure `/organizations/[slug]/settings/sso`.
# Optional SP signing (only if your IdP requires signed AuthnRequests — generate PKCS#8 PEM):
# SAML_SP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----..."
#
# Optional BoxyHQ Jackson sidecar (PRD §31 — Better Auth native SAML does not require Jackson).
# Docker Compose profile (shares Postgres): docker compose -f docker-compose.dev.yml --profile jackson up -d
# For Jackson-backed integrations only (not used by Better Auth SSO routes in this repo):
# JACKSON_URL=http://localhost:5225
# JACKSON_API_KEY=""
# JACKSON_PRODUCT=starter
# JACKSON_PUBLIC_HOST_URL=http://localhost:5225
# SAML_AUDIENCE=http://localhost:5225

# --- Svix (optional; outbound webhooks — self-host or cloud) ---
# SVIX_SERVER_URL="http://localhost:8071"
# SVIX_AUTH_TOKEN=""
# SVIX_JWT_SECRET=""          # Svix server container (see Phase 11 Docker)
# SVIX_WEBHOOK_SECRET=""     # Operational webhook signing secret from Svix dashboard
